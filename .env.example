# =============================================
# App Listino - File di configurazione esempio
# Copia questo file in .env.local e personalizzalo
# =============================================

# === Sicurezza ===
# Genera una chiave lunga e casuale (es. openssl rand -base64 32)
JWT_SECRET=super-long-random-secret-change-in-production
# Imposta a "true" solo in produzione con HTTPS
COOKIE_SECURE=false

# === Email (Gmail con App Password) ===
GMAIL_USER=tuoemail@gmail.com
GMAIL_APP_PASSWORD=la-tua-app-password-a-16-caratteri
# Email di fallback se non configurata per filiale
ORDER_EMAIL_TO=ordini@azienda.it

# === Google Maps Places Autocomplete ===
# Ottieni la chiave da Google Cloud Console (abilita Maps JavaScript API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === AI Enrichment (OpenAI) ===
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modello consigliato (più economico e veloce)
AI_MODEL=gpt-4o-mini

# === Backup Database & S3 (Hetzner Object Storage) ===
# Numero massimo di backup locali
DB_BACKUP_MAX_FILES=30
# Abilita scheduler automatico
DB_BACKUP_AUTO_ENABLED=true
# Intervallo in minuti tra un backup e l'altro (360 = 6 ore)
DB_BACKUP_AUTO_INTERVAL_MINUTES=360
DB_BACKUP_AUTO_RUN_ON_START=true
DB_BACKUP_AUTO_UPLOAD_TO_S3=true

# Configurazione S3 (compatibile Hetzner, Wasabi, ecc.)
DB_BACKUP_S3_ENDPOINT=https://your-endpoint.hetzner.com
DB_BACKUP_S3_REGION=us-east-1
DB_BACKUP_S3_BUCKET=your-bucket-name
DB_BACKUP_S3_PREFIX=db-backups
DB_BACKUP_S3_ACCESS_KEY_ID=your-access-key
DB_BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
DB_BACKUP_S3_FORCE_PATH_STYLE=true
# Numero massimo di backup mantenuti su S3
DB_BACKUP_S3_MAX_FILES=120

# =============================================
# Note:
# - Non committare mai questo file con dati reali
# - In produzione usa Docker secrets o variabile d'ambiente
# - Per sviluppo locale usa .env.local (ignorato da git)
# =============================================
